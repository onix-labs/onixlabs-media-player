{
  "name": "onixlabs-media-player",
  "version": "2026.11.0",
  "description": "Cross-platform media player with real-time audio visualizations, video playback, and MIDI synthesis",
  "author": {
    "name": "ONIXLabs",
    "email": "info@onixlabs.io"
  },
  "main": "src/electron/dist/main.js",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/ensure-electron-binary.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test && vitest run --config vitest.electron.config.ts",
    "build:ci": "npm run lint && npm run build && npm run build:electron && npm run test:angular:coverage && npm run test:electron:coverage",
    "test:angular": "ng test",
    "test:angular:coverage": "ng test --configuration coverage",
    "test:electron": "vitest run --config vitest.electron.config.ts",
    "test:electron:coverage": "vitest run --config vitest.electron.config.ts --coverage",
    "test:electron:watch": "vitest --config vitest.electron.config.ts",
    "lint": "eslint src/angular src/electron --ext .ts",
    "dev": "npm run lint && npm run build:preload && concurrently -k \"ng serve\" \"wait-on http://localhost:4300 && cross-env NODE_ENV=development DEV_SERVER_URL=http://localhost:4300 NODE_OPTIONS=--import=tsx electron src/electron/main.ts\"",
    "dev:first-run": "npm run lint && npm run build:preload && concurrently -k \"ng serve\" \"wait-on http://localhost:4300 && cross-env NODE_ENV=development DEV_SERVER_URL=http://localhost:4300 NODE_OPTIONS=--import=tsx electron src/electron/main.ts --first-run\"",
    "build:electron": "tsx scripts/build-electron.ts",
    "build:electron:dev": "tsc -p src/electron/tsconfig.prod.json",
    "build:preload": "esbuild src/electron/preload.ts --bundle --platform=node --format=esm --outfile=src/electron/dist/preload.js --external:electron",
    "build:all": "npm run lint && npm run build && npm run build:electron",
    "obfuscate": "tsx scripts/obfuscate.ts",
    "package": "npm run build:all && npm run obfuscate && electron-builder",
    "package:mac": "npm run build:all && npm run obfuscate && electron-builder --mac",
    "package:win": "npm run build:all && npm run obfuscate && electron-builder --win",
    "package:linux": "npm run build:all && npm run obfuscate && electron-builder --linux",
    "package:all": "npm run build:all && npm run obfuscate && electron-builder -mwl",
    "binaries": "bash scripts/build-binaries.sh",
    "package:mac:local": "npm run build:all && npm run obfuscate && electron-builder --mac dmg --publish never --$(node -p process.arch)"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "electron-log": "^5.4.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "javascript-obfuscator": "^5.9.1",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "undici": "7.30.1",
    "zod": "^4.6.6"
  },
  "build": {
    "appId": "com.onixlabs.media-player",
    "productName": "ONIXPlayer",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "onix-labs",
      "repo": "onixlabs-media-player",
      "releaseType": "release",
      "vPrefixedTagName": false
    },
    "files": [
      "dist/**/*",
      "src/electron/dist/**/*",
      "public/icon-macos.png",
      "public/icon-windows.ico",
      "public/icon-windows-linux.png",
      "public/icon-file.icns",
      "public/icon-file.ico",
      "public/icon-file.png",
      "node_modules/electron-log/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/bin/${os}-${arch}",
        "to": "bin"
      },
      {
        "from": "LICENSE",
        "to": "licenses/ONIXPlayer-LICENSE.txt"
      },
      {
        "from": "dist/onixlabs-media-player/3rdpartylicenses.txt",
        "to": "licenses/JavaScript-libraries.txt"
      }
    ],
    "beforePack": "scripts/verify-bundled-resources.cjs",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "public/icon-macos.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/icon-windows.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "public/icon-windows-linux.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "aac",
        "name": "AAC Audio",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "wma",
        "name": "WMA Audio",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "mp4",
        "name": "MP4 Video",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "m4v",
        "name": "M4V Video",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "mkv",
        "name": "MKV Video",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "avi",
        "name": "AVI Video",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "mov",
        "name": "MOV Video",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "mid",
        "name": "MIDI File",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "midi",
        "name": "MIDI File",
        "role": "Viewer",
        "icon": "public/icon-file"
      },
      {
        "ext": "opp",
        "name": "ONIXPlayer Playlist",
        "role": "Editor",
        "icon": "public/icon-file"
      }
    ]
  }
}
